# Copy to .env. Generate a secret with: openssl rand -hex 32
SCHEDU_SETUP_TOKEN=
# Must match the URL used in the browser; no path. Use https://your-institute-domain for production.
SCHEDU_ORIGIN=http://localhost:8080
SCHEDU_HTTP_PORT=8080
# Keep loopback when using a reverse proxy on this host. Set to 0.0.0.0 for a LAN-only HTTP trial.
SCHEDU_BIND_ADDRESS=127.0.0.1
# Build-time only. Mainland China defaults to npmmirror.
# An existing .env value overrides the Compose default; update it as well.
# npm registry and Docker image registry are separate settings.
NODE_IMAGE=node:24.19.0-bookworm-slim
NPM_REGISTRY=https://registry.npmmirror.com
